package "eventUpdateCmdPattern" {
  class Command {
    +executeClass: any
    +undo: any
    +value: any
    +Command(executeClass: any, undo: any, value: any)
  }
  class EventUpdate {
    +current: any
    +commands: any[]
    +action(command: any): void
    +execute(command: any): void
    -verifyOptimisticUpdate(command: any): void
    -getWaveformIndexes(filterBeatsNEctopicList: any): void
    -getMergeBeatsNEctopicList(filterBeatsNEctopicList: any): void
    +undo(): void
    +getCurrentValue(): void
    +getResult(): void
    }
    note left: EventUpdate에서 \nCommand Class를 사용
}
EventUpdate -up-> Command : uses

PostOthersCommand -down-> Command : uses
PostOthersCommand -up-> PostOthers : uses

PostAfibCommand -down-> Command : uses
PostAfibCommand -up-> PostAfib : uses

PostPauseCommand -down-> Command : uses
PostPauseCommand -up-> PostPause : uses

