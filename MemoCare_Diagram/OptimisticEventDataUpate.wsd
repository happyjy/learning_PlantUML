@startuml

class OptimisticEventDataUpdate {
    +static basisBpm: number
    +validateOverHrLimit(updateTargetWaveformIndex: WaveformIndex, comparisonWaveformIndexList: WaveformIndex[]): boolean
    +validateSBeatInAf(afList: TimeEvent[], waveformIndex: WaveformIndex, recordingStartMs: Ms): boolean
    +getAfList(): Generator
    +getRecordingStartMs(): Generator
    +getSelectionStrip(): Generator
}

' ------------------------------------------------------------------------------------------------
' ------------------------------------------------------------------------------------------------
' ------------------------------------------------------------------------------------------------

class EventReviewOptimisticEventDataUpdateForBeatEvent {
    -rfdcClone: any
    +constructor()
    +mergeBeatsNEctopicList(filterBeatsNEctopicList: BeatsNBeatEvents[]): OptimisticEventDataUpdateForBeats
    +setOptimisticEventDataUpdateResult(isValidationSuccessful: boolean, result: OptimisticEventDataUpdateForBeats): isValidationSuccessful: boolean, result: OptimisticEventDataUpdateForBeats
}
class PostBeat {
    -result: any
    -reqParam: any
    +constructor(reqParam: any)
    +*optimisticEventDataUpdate(updateReqOption: UpdateReqOptionProps): Generator
    +updateLogic(reqBody: ReqBody, mergedBeatsNEctopicList: OptimisticEventDataUpdateForBeats): OptimisticEventDataUpdateForBeats
    +*validateExecution(updateReqOption: UpdateReqOption, mergedBeatsNEctopicList: OptimisticEventDataUpdateForBeats): Generator | boolean
    +*_validation(reqBody: ReqBody, updateReqOption: UpdateReqOption, mergedBeatsNEctopicList: OptimisticEventDataUpdateForBeats): Generator
    +getResult(): any
}
class PatchBeat {
    -result: any
    -reqParam: any
    +validation(reqBody: , updateReqOption: any, mergedBeatsNEctopicList: OptimisticEventDataUpdateForBeats, copyMergedBeatsNEctopicList: any): OptimisticEventDataUpdateForBeats
}
class DeleteBeat {
    -result: any
    -reqParam: any
    +constructor(reqParam: any)
    +optimisticEventDataUpdate(updateReqOption: UpdateReqOptionProps): void
    +updateLogic(reqBody: ReqBody, mergedBeatsNEctopicList: OptimisticEventDataUpdateForBeats): OptimisticEventDataUpdateForBeats
    +_validation(): void
    +getResult(): any
}
OptimisticEventDataUpdate <|-up- EventReviewOptimisticEventDataUpdateForBeatEvent
EventReviewOptimisticEventDataUpdateForBeatEvent <|-up- PostBeat
EventReviewOptimisticEventDataUpdateForBeatEvent <|-up- PatchBeat
EventReviewOptimisticEventDataUpdateForBeatEvent <|-up- DeleteBeat
