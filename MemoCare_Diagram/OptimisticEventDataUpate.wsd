class EventReviewOptimisticEventDataUpdateForTimeEvent {
    +validation(): void
    +*setTimeEventsList(freshLeadOffList: TimeEvent[], freshTimeEventList: TimeEvent[]): Generator
    +validatePauseInQ(staleTimeEvent: TimeEvent, recordingStartMs: Ms, selectedBeatsInfo: waveformIndexList: WaveformIndex[], beatTypeList: BeatType[]): boolean
    +getBeatsNEctopicList(): Generator
    +getTimeEventList(): Generator
    +getSelectedEventList(): Generator
    +getIsWholeUnMark(): Generator
    +isFullyExclusiveRangeOfSelectionStrip(onsetSelectionStrip: number, terminationSelectionStrip: number, onsetRange: number, terminationRange: number): boolean
    +isFullyInclusiveRangeOfSelectionStrip(onsetSelectionStrip: number, terminationSelectionStrip: number, onsetRange: number, terminationRange: number): boolean
    +isExclusiveRangeOfSelectionStrip(onsetSelectionStrip: number, terminationSelectionStrip: number, onsetRange: number, terminationRange: number): boolean
    +isInclusiveRangeOfSelectionStrip(onsetSelectionStrip: number, terminationSelectionStrip: number, onsetRange: number, terminationRange: number): boolean
    +isPartiallyInclusiveRangeOfSelectionStrip(onsetSelectionStrip: number, terminationSelectionStrip: number, onsetRange: number, terminationRange: number, isIncludeBorder: boolean): boolean
    +getRemainingRange(start: number, end: number, excludeList: any[]): [number, number][]
    +findOverLappingEvent(baseSelectionStripTimeStamp: number, partiallyInclusiveRange: TimeEvent[]): TimeEvent
    +sortTimeEventList(freshTimeEventList: TimeEvent[]): TimeEvent[]
    +getAvailableEventRange(excludedEventList: any[], responseInfo: TimeEventForOptimisticUpdate[], eventType: optimisticEventDataUpdateForTimeEventConstTypes): TimeEventForOptimisticUpdate[]
}
class OptimisticEventDataUpdateForNormal {
    -normalTypeEventList: TimeEventType[]
    +validation(): void
    +*optimisticEventData(updateReqOption: optimisticEventDataUpdateForTimeEventParam): void
    - *handleAddEvent(updateReqOption: EventHandlingParams): void
    - *handleRemoveEvent(updateReqOption: EventHandlingParams): void
}
class OptimisticEventDataUpdateForPause {
    +validation(): void
    +*optimisticEventData(updateReqOption: optimisticEventDataUpdateForTimeEventParam): void
    - *handleAddEvent(updateReqOption: EventHandlingParams): void
    - *handleDeleteEvent(updateReqOption: EventHandlingParams): void
}
class OptimisticEventDataUpdateForAVBlock {
    +validation(): void
    +*optimisticEventData(updateReqOption: optimisticEventDataUpdateForTimeEventParam): void
    - *handleAddEvent(updateReqOption: EventHandlingParams): void
    - *handleDeleteEvent(updateReqOption: EventHandlingParams): void
}
package "eventReview_PostAfib" {
    class PostAfib {
        +result: any
